#!/bin/bash
# pre-push hook: push前にリモートの最新を取得し、ローカルが古い場合はpushを中断する
#
# 設定方法（各PCで1回実行）:
#   bash tools/git-hooks/install.sh   (Linux/Mac/WSL)
#   tools\git-hooks\install.bat       (Windows)

set -e

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ -z "$BRANCH" ]; then
    exit 0  # detached HEAD はスキップ
fi

# push先のリモートとrefを標準入力から読み取る
while read local_ref local_sha remote_ref remote_sha; do
    # 新規ブランチ（remote_shaが全てゼロ）はスキップ
    if echo "$remote_sha" | grep -q '^0\{40\}'; then
        echo "[pre-push] 新しいブランチです。push を続行します。"
        exit 0
    fi

    # ローカルがリモートの子孫かチェック（fast-forward可能か）
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        echo ""
        echo "======================================================"
        echo "  エラー: ローカルがリモートより古い状態です！"
        echo ""
        echo "  先に以下を実行してください:"
        echo "    git pull --rebase origin $BRANCH"
        echo ""
        echo "  その後もう一度 git push してください。"
        echo "======================================================"
        echo ""
        exit 1
    fi
done

echo "[pre-push] 最新状態を確認しました。push を続行します。"
exit 0
