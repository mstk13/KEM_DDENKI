# ==============================================================
# Gmail 設定（GEPS メール取込 + 新着案件メール通知で使用）
# ==============================================================
# Gmail アドレス（GEPS の調達情報通知の送信先と同じアドレス）
GMAIL_USER=your-email@gmail.com

# Gmail アプリパスワード（16文字、通常のパスワードではない）
# 取得方法: https://myaccount.google.com/apppasswords
# ※ 2段階認証を有効にしてから発行する
GMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# 新着案件の通知メール送信先（カンマ区切りで複数可）
BID_EMAIL_TO=manager@example.com,sub@example.com

# ==============================================================
# 任意設定（未指定なら config.py の既定値を使用）
# ==============================================================
# BID_SCRAPE_INTERVAL=2
# BID_DEADLINE_ALERT_DAYS=3
# BID_USE_PLAYWRIGHT=0
