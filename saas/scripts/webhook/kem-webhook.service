# ============================================================
# systemd サービスファイル（GitHub Webhook レシーバー）
#
# インストール:
#   sudo cp kem-webhook.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable kem-webhook
#   sudo systemctl start kem-webhook
#
# ログ確認:
#   sudo journalctl -u kem-webhook -f
# ============================================================

[Unit]
Description=KEM_DDENKI GitHub Webhook Receiver
After=network.target

[Service]
Type=simple
User=masakem
WorkingDirectory=/home/masakem/KEM_DDENKI/saas/scripts/webhook
ExecStart=/usr/bin/python3 /home/masakem/KEM_DDENKI/saas/scripts/webhook/receiver.py
Restart=always
RestartSec=5

# 環境変数（WEBHOOK_SECRETは必ず変更すること）
Environment=WEBHOOK_SECRET=change-me-to-your-github-webhook-secret
Environment=WEBHOOK_PORT=9000
Environment=TARGET_BRANCH=refs/heads/developer

[Install]
WantedBy=multi-user.target
