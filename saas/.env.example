# ============================================================
# KEM_DDENKI 次期版 環境変数
# このファイルを .env にコピーして値を設定してください
# cp .env.example .env
# ============================================================

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.35

# Database
DB_NAME=kensetsu_saas
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Ports
WEB_PORT=8000
NGINX_PORT=8081

# Redis
REDIS_URL=redis://redis:6379/0

# 現行版DB接続（データ移行用）
LEGACY_DB_URL=postgresql://kem:kem@localhost:5433/kem_main
