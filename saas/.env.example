# SaaS版 環境変数サンプル
# cp .env.example .env して値を設定してください

DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=kensetsu_saas
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# --- Cloudflare Tunnel（社外アクセス用・任意） ---
# Cloudflare Zero Trust ダッシュボードで作成したトンネルのトークンを設定
# 設定しない場合、cloudflaredコンテナは起動しません
# CLOUDFLARE_TUNNEL_TOKEN=eyJh...
