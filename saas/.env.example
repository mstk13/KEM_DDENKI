# ============================================================
# KEM_DDENKI 次期版 環境変数
# このファイルを .env にコピーして値を設定してください
# cp .env.example .env
# ============================================================

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
# 外部公開する場合は、そのホスト名を必ず足すこと（足さないと 400 になる）
# 例: localhost,127.0.0.1,desktop-rmsk0vg.tail8efe0d.ts.net
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# リバースプロキシ（Tailscale serve 等）が TLS を終端して http へ渡す場合、
# HTTPS オリジンを信頼させないと POST がすべて 403 になる
# 例: https://desktop-rmsk0vg.tail8efe0d.ts.net,http://localhost:8000
CSRF_TRUSTED_ORIGINS=

# 公開ポート（同一PCで2スタック動かす場合はここをずらす）
WEB_PORT=8000
DB_PORT=5432
REDIS_PORT=6379

# 社長ポジションのログイン時に要求される管理者パスワード
PRESIDENT_PIN=1234

# Database
DB_NAME=kensetsu_saas
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Claude API（AI分析機能に必要）
# https://console.anthropic.com/settings/keys で取得
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# ローカル推論（ADR-0010「AI推論の3層分割」）
# Ollama はホストの Windows 側で稼働させる。未設定でも動く。
# 層A（品目名の候補絞り込み / bge-m3）は既定で有効。
# 層B（候補からの選択 / qwen3:8b）は既定で無効。
# タスクごとに精度を実測してから True にすること:
#   python manage.py verify_item_matching --company 1 \n#       --fixture tests/fixtures/item_matching_pairs.json
OLLAMA_CHAT_ENABLED=False
#OLLAMA_BASE_URL=http://host.docker.internal:11434
#OLLAMA_CHAT_MODEL=qwen3:8b
# OLLAMA_KEEP_ALIVE はここに書いても効かない。ホストのシステム環境変数が
# compose の変数展開で優先されるため、コンテナには settings.py の既定 5m を使う。

# --- メール送信（アラート通知・任意） ---
# 未設定の場合はコンソール（ログ）に出力されます
# OCN の場合: ポート465 + SSL
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.ocn.ne.jp
# EMAIL_PORT=465
# EMAIL_USE_TLS=False
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=kenmochi@oregano.ocn.ne.jp
# EMAIL_HOST_PASSWORD=your-ocn-password
# DEFAULT_FROM_EMAIL=kenmochi@oregano.ocn.ne.jp

# --- Cloudflare Tunnel（社外アクセス用・任意） ---
# Cloudflare Zero Trust ダッシュボードで作成したトンネルのトークンを設定
# 設定しない場合、cloudflaredコンテナは起動しません
# CLOUDFLARE_TUNNEL_TOKEN=eyJh...
