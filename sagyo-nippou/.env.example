# メール通知を使う場合のみ設定（notifier.py）
GMAIL_USER=your-email@gmail.com          # Gmail アドレス
GMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx        # Gmail アプリパスワード（16文字・2段階認証必須）
NIPPOU_EMAIL_TO=boss@example.com          # 送信先（カンマ区切りで複数可）

# 任意設定
# NIPPOU_COMPANY_NAME=株式会社ケンモチ電機
# NIPPOU_DEFAULT_START=08:00
# NIPPOU_DEFAULT_END=17:00
# NIPPOU_DEFAULT_BREAK=60
