# Claude API（自動抽出・HP事業概要取得に必須）
# https://console.anthropic.com/settings/keys でAPIキーを発行して貼り付ける
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# 抽出に使うモデル（既定: claude-opus-4-8）
# EIGYO_MODEL=claude-opus-4-8

# フォルダ監視の場所（未設定なら data/inbox, data/files を使用）
# EIGYO_INBOX_DIR=C:\Users\Kenmo\KEM_DDENKI\eigyo-kanri\data\inbox
# EIGYO_FILES_DIR=C:\Users\Kenmo\KEM_DDENKI\eigyo-kanri\data\files

# DB ファイルはプロジェクト直下の data/ フォルダに保存されます。
# 共有フォルダを使う場合はルートの .env で KEM_DATA_DIR を設定してください。
