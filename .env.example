# ============================================================
# KEM_DDENKI 共通設定
# ============================================================
# このファイルを .env にコピーして値を設定してください。
#   cp .env.example .env   (Mac/Linux)
#   copy .env.example .env (Windows)

# --- データベース共有フォルダ ---
# 全アプリのDBファイルを共有フォルダに置く場合に設定します。
# 未設定の場合、各アプリのディレクトリ内にDBが作成されます。
#
# 例（Windows 共有フォルダ）:
#   KEM_DATA_DIR=\\192.168.0.27\kem_data
#   KEM_DATA_DIR=Z:\kem_data
#
# 例（Mac/Linux NFS/SMB マウント）:
#   KEM_DATA_DIR=/mnt/shared/kem_data
#
# KEM_DATA_DIR=

# --- Gmail 通知（入札案件管理・作業日報で共通） ---
# GMAIL_USER=your-email@gmail.com
# GMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- 入札案件管理 ---
# BID_EMAIL_TO=manager@example.com

# --- 作業日報 ---
# NIPPOU_EMAIL_TO=boss@example.com

# --- 営業管理（Claude API） ---
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
